# Copy to .env and fill in the two blanks. .env is gitignored; never commit it.

# OpenAI-compatible LLM endpoint. Any provider works; these are the ones this project runs on.
V2S_LLM_BASE_URL=https://api.groq.com/openai/v1
V2S_LLM_MODEL=openai/gpt-oss-120b
V2S_LLM_API_KEY=your-llm-api-key

# Signs manager tokens and gates POST /api/login. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The app refuses to start without it.
V2S_AUTH_SECRET=generate-a-long-random-value

# Optional
# V2S_DB_PATH=./voice-to-sop.db
# V2S_TMP_DIR=./tmp
# V2S_CORS_ORIGINS=["https://your-frontend"]
# V2S_ASR_DEVICE=auto          # auto | cpu | cuda | mps
