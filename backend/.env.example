# Copy to .env and fill in the blanks. .env is gitignored; never commit it.

# OpenAI-compatible LLM endpoint. Any provider works; these are the ones this project runs on.
V2S_LLM_BASE_URL=https://api.groq.com/openai/v1
V2S_LLM_MODEL=openai/gpt-oss-120b
V2S_LLM_API_KEY=your-llm-api-key

# Database - Supabase Postgres. For local dev, run `supabase start` (see backend/supabase/) and
# use its printed values; `supabase status` reprints them later. Point V2S_DATABASE_URL at the
# Supavisor *session-mode* pooler for a deployed project, not transaction-mode - transaction
# pooling breaks psycopg3's prepared-statement cache.
V2S_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# V2S_DATABASE_MIGRATE_URL=   # direct, unpooled connection for Alembic; defaults to the above

# Supabase Auth/Storage. supabase_anon_key/service_role_key are the "Publishable"/"Secret" keys
# `supabase status` prints (service role key is server-only - never ship it to the frontend).
# No JWT secret to configure: current_person() verifies tokens against Supabase's public JWKS.
V2S_SUPABASE_URL=http://127.0.0.1:54321
V2S_SUPABASE_ANON_KEY=your-publishable-key
V2S_SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Only needed for `docker-compose.yml`'s build (not plain `uvicorn`): same values as
# V2S_SUPABASE_URL/V2S_SUPABASE_ANON_KEY above, duplicated under the VITE_ prefix so
# build.args can read them from this file - Vite inlines them into the frontend bundle at
# build time (see Dockerfile), so the plain V2S_ vars aren't visible to that build stage.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional
# V2S_TMP_DIR=./tmp
# V2S_CORS_ORIGINS=["https://your-frontend"]
# V2S_ASR_DEVICE=auto          # auto | cpu | cuda | mps
# V2S_STORAGE_RESUME_BUCKET=candidate-resumes
