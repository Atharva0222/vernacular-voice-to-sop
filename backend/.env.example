# Required: signs manager tokens and gates /api/login. Use a long random value.
V2S_AUTH_SECRET=change-me

# OpenAI-compatible LLM endpoint. Defaults target local Ollama.
V2S_LLM_BASE_URL=http://localhost:11434/v1
V2S_LLM_MODEL=llama3.2:3b
V2S_LLM_API_KEY=ollama

# Optional
# V2S_DB_PATH=./voice-to-sop.db
# V2S_CORS_ORIGINS=["https://your-frontend"]
