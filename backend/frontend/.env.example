# Copy to .env. These are public-by-design (the anon key is meant to be shipped to the
# browser), but still vary per environment (local `supabase start` vs a deployed project), so
# they're configured, not hardcoded.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-publishable-key
